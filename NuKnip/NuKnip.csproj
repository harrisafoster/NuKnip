<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <PackAsTool>true</PackAsTool>
    <ToolCommandName>nuknip</ToolCommandName>

    <PackageId>NuKnip</PackageId>
    <Version>0.1.0</Version>
    <Title>NuKnip</Title>
    <Authors>Harris Foster</Authors>
    <Description>
      A CI-friendly .NET tool that detects potentially unused
      top-level NuGet package references.
    </Description>
    <PackageTags>
      dotnet-tool;nuget;dependencies;unused-packages;analysis;ci
    </PackageTags>

    <PackageReleaseNotes>
      Initial preview release.

      - Detects used and potentially unused top-level NuGet packages.
      - Identifies packages whose usage cannot be determined.
      - Supports CI-friendly exit codes.
      - Supports analysis without rebuilding through --no-build.
      - Generates an unused-package report.
    </PackageReleaseNotes>

    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>

    <PackageProjectUrl>https://github.com/harrisafoster/NuKnip</PackageProjectUrl>
    <RepositoryUrl>https://github.com/harrisafoster/NuKnip</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>

    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">
      true
    </ContinuousIntegrationBuild>

    <PackageOutputPath>$(MSBuildProjectDirectory)/../artifacts</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="StyleCop.Analyzers" Version="1.3.151-beta" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
    <AdditionalFiles Include="stylecop.json" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="/" Link="README.md" />
    <None Include="../LICENSE" Pack="true" PackagePath="/" Link="LICENSE" />
  </ItemGroup>
</Project>